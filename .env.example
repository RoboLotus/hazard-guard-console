# HazardGuard physical Jetson runtime example.
# Copy this file to a local runtime.env and adjust paths on the Jetson.
# Never commit the copied runtime file or credentials.

HAZARD_GUARD_DEPLOYMENT_TARGET=physical
HAZARD_GUARD_MODE_CONTROL_ENABLED=1
HAZARD_GUARD_ROS_ENABLED=1

# Keep these identical to the ROSMASTER bringup shell. The values below are
# safe examples for a single-Jetson ROS graph; preserve the robot's current
# ROS_DOMAIN_ID instead of changing it blindly.
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1

# ROS Bag has no backend-only enable flag. Start the Robot recorder with
# enable_control_services:=true; WebUI ON/OFF remains an in-memory safety gate.
# The recorder storage path is a Robot launch argument, not an environment variable.

# Physical beacon deployment is fail-closed until the Robot-side stop guard,
# BLE confirmation and administrator approval flow are all configured.
HAZARD_GUARD_DISPENSER_DROP_ENABLED=0
HAZARD_GUARD_DISPENSER_STOP_SPEED_MPS=0.02
HAZARD_GUARD_DISPENSER_REQUEST_STORE=/home/jetson/.local/state/hazard_guard/dispenser/backend_requests.sqlite3
# Generate two independent random secrets on the Jetson and keep this copied
# file mode 0600. The approval secret must match the Robot mission manager.
HAZARD_GUARD_DISPENSER_APPROVAL_SECRET=
HAZARD_GUARD_ADMIN_API_TOKEN=
HAZARD_GUARD_ADMIN_OPERATOR_ID=operator
HAZARD_GUARD_INCIDENT_STORE=/home/jetson/.local/state/hazard_guard/incidents/incidents.sqlite3
HAZARD_GUARD_DISPENSER_BATTERY_STALE_SEC=15

# YOLO person safety is applied only in patrol mode. The backend forces it off
# during 2D mapping and RGB-D 3D collection while keeping the HP60C camera on.
HAZARD_GUARD_PERSON_SAFETY_ENABLED=1
HAZARD_GUARD_PERSON_CAMERA_START=1
HAZARD_GUARD_PERSON_MODEL_PATH=/absolute/path/to/yolo11n.engine
HAZARD_GUARD_PERSON_DEVICE=cuda:0
HAZARD_GUARD_PERSON_RATE_HZ=6.0
HAZARD_GUARD_PERSON_CONFIDENCE=0.4
HAZARD_GUARD_PERSON_IMAGE_SIZE=640
HAZARD_GUARD_PERSON_DEPTH_REGISTERED=1
